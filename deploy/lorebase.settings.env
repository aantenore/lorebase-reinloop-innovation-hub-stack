# Demo settings for the Lorebase compose file (no secrets: those live in the generated,
# git-ignored deploy/lorebase.env, which is read after this file and wins).
#
# Lorebase release the hub runs: the published images ghcr.io/aantenore/lorebase and
# lorebase-ml at this tag, with the compose file and the configuration of the same release
# under deploy/ (scripts/lorebase-up.sh; `sync` refreshes them from a checkout at tag v<version>).
# LOREBASE_FROM_SOURCE=1 builds from ../lorebase instead.
LOREBASE_VERSION=0.3.1
# Self approval: the demo runs with auth mode none (one anonymous principal), so the author of a
# rule-change Proposal must be allowed to approve it.
LOREBASE__KEEPER__PROPOSALS__ALLOW_SELF_APPROVAL=true
# The `set_rule` Operation has review policy `never`, so it commits straight to the protected
# `main` branch; every other change needs a Proposal.
LOREBASE__KEEPER__OPERATIONS__DIRECT_COMMIT_ON_PROTECTED=true
# Browser access for the Lorebase web app in live mode (cross origin, no cookies); ETag and
# If-None-Match are handled by Keeper's defaults.
LOREBASE__KEEPER__CORS__ALLOW_ORIGINS='["http://localhost:5180","http://127.0.0.1:5180"]'
# Write rate limit per principal (defaults 300 a minute, burst 60): the demo writes as one
# anonymous principal, and at GAME_TIME_SCALE=20 its idea, review and evidence writes come about
# 20 times as fast. Passed to Keeper by deploy/compose.hub.yaml.
LOREBASE__KEEPER__LIMITS__RATE__WRITES__REQUESTS_PER_MINUTE=6000
LOREBASE__KEEPER__LIMITS__RATE__WRITES__BURST=600

# Herald (profile mcp): the agents' read access to the world, http://127.0.0.1:8290/mcp.
HERALD_HOST_PORT=8290
# Keeper runs with auth mode none: calls without a bearer are forwarded as they are.
HERALD_ALLOW_ANONYMOUS=true
HERALD_DOMAIN=hub
HERALD_BRANCH=main
