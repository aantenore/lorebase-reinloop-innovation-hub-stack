{
  "system": { "name": "hub-group" },
  "members": {},
  "ports": {
    "topology": { "adapter": "basic-topology" },
    "execution": { "adapter": "sqlite-execution", "options": { "path": "${env:HUB_DATA_DIR:-../../data}/plexus/journal.db", "maxRuns": 2000 } },
    "attribution": { "adapter": "rule-attribution" }
  },
  "topology": { "kind": "sequence", "steps": [] },
  "limits": {
    "system": {
      "timeoutMs": 180000,
      "stepTimeoutMs": 120000,
      "maxSteps": 40,
      "maxParallel": 4,
      "maxIterations": 5,
      "maxHandoffs": 2
    }
  }
}
